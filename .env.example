APP_NAME=ShoeThrift
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Timestamps are stored in UTC; this is the timezone they are displayed in.
APP_DISPLAY_TIMEZONE=Asia/Kuala_Lumpur

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# HitPay (https://docs.hitpayapp.com). Never commit real keys.
# HITPAY_SALT = the webhook endpoint salt (Developers > Webhook Endpoints).
HITPAY_API_KEY=
HITPAY_SALT=
HITPAY_API_URL=https://api.sandbox.hit-pay.com
# Public HTTPS base for the webhook (e.g. your ngrok URL). Run: php artisan hitpay:webhook-url
HITPAY_PUBLIC_URL=
HITPAY_CURRENCY=MYR
HITPAY_PAYMENT_WINDOW_MINUTES=30

# Cash on Delivery: block COD after this many failed deliveries; optional max order total in RM (empty = no limit).
SHOP_COD_MAX_FAILED_DELIVERIES=2
SHOP_COD_MAX_TOTAL=

# Content pages and returns (placeholders for the FYP; see config/shop.php)
SHOP_SUPPORT_EMAIL=support@shoethrift.test
SHOP_SUPPORT_PHONE="03-1234 5678"
SHOP_RETURN_WINDOW_DAYS=7

# Admin dashboard: "low stock" = a multi-pair product down to this many pairs or fewer
SHOP_LOW_STOCK_THRESHOLD=2

# Email (verification links, password resets). MAIL_MAILER=log (above) writes every email to
# storage/logs/laravel.log: no account needed. To see emails in a web inbox instead, create a free
# Mailtrap "Email Testing" inbox and replace the MAIL_* lines with its SMTP settings:
# MAIL_MAILER=smtp
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=your-mailtrap-inbox-username
# MAIL_PASSWORD=your-mailtrap-inbox-password

# Timed cart holds: minutes a pair stays reserved in a cart, most pairs per cart, adds per minute.
CART_HOLD_MINUTES=15
SHOP_CART_MAX_ITEMS=3
SHOP_CART_ADDS_PER_MINUTE=10
